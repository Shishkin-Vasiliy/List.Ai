       label="  { index = 2   | value = 55 | {prev = 1 | next = 0} }"];
node3 [shape=Mrecord; style=filled; fillcolor="#000040A0"; color="#FFFFFF"; fontcolor="#FFFFFF";
       label="  { index = 3   | value = D01B0EB | {prev = -1 | next = -1} }"];
