node [shape=circle; style=filled; fontcolor="#FFFFFF"; width=0.6; fixedsize=true];
tail [label="tail", fillcolor="#FF6347A0", color="#FFFFFF"];
head [label="head", fillcolor="#A52A2AA0", color="#FFFFFF"];
tail:s -> node1:nw;
