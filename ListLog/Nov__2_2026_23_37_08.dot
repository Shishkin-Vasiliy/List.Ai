digraph {
bgcolor="#283f3f";
rankdir=TB;
splines=ortho;
nodesep=0.5;
ranksep=0.8;
{ rank=same;
node0 [shape=Mrecord; style=filled; fillcolor="#6A184DA0"; color="#A5497EA0"; fontcolor="#FFFFFF";
       label="  { index = 0    | value = D01B0EB | {prev = 5 | next = 1} }"];
node1 [shape=Mrecord; style=filled; fillcolor="#BA55D3A0"; color="#FFFFFF"; fontcolor="#FFFFFF";
       label="  { index = 1   | value = 50 | {prev = 0 | next = 2} }"];
node2 [shape=Mrecord; style=filled; fillcolor="#006000A0"; color="#FFFFFF"; fontcolor="#FFFFFF";
       label="  { index = 2    | value = 55 | {prev = 1 | next = 3} }"];
node3 [shape=Mrecord; style=filled; fillcolor="#006000A0"; color="#FFFFFF"; fontcolor="#FFFFFF";
       label="  { index = 3    | value = 60 | {prev = 2 | next = 4} }"];
node4 [shape=Mrecord; style=filled; fillcolor="#006000A0"; color="#FFFFFF"; fontcolor="#FFFFFF";
       label="  { index = 4    | value = 70 | {prev = 3 | next = 5} }"];
node5 [shape=Mrecord; style=filled; fillcolor="#000080A0"; color="#FFFFFF"; fontcolor="#FFFFFF";
       label="  { index = 5    | value = 80 | {prev = 4 | next = 0} }"];
}
edge [color="#FFFFFF"];
node0 -> node1 [weight=100];
node1 -> node0 [weight=1];
node1 -> node2 [weight=100];
node2 -> node1 [weight=1];
node2 -> node3 [weight=100];
node3 -> node2 [weight=1];
node3 -> node4 [weight=100];
node4 -> node3 [weight=1];
node4 -> node5 [weight=100];
node5 -> node4 [weight=1];
node5 -> node0 [weight=1];
node0 -> node5 [weight=1];
node [shape=circle; style=filled; fontcolor="#FFFFFF"; width=0.9; fixedsize=true];
head [label="head", fillcolor="#000080A0", color="#FFFFFF"];
tail [label="tail", fillcolor="#BA55D3A0", color="#FFFFFF"];
tail:s -> node1:n;
head:s -> node5:n;
}
